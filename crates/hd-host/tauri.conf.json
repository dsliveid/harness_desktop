{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "harness_desktop",
  "version": "0.1.0",
  "identifier": "com.harness.desktop",
  "build": {
    "frontendDist": "ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node ../../web/dev-server.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "harness_desktop",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 http://127.0.0.1:1420 ws://localhost:1420 ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
