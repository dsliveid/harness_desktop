{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "baseline-shell",
  "description": "本地基线页（壳自有的设置/配对界面）的 IPC 面：允许调用壳全部自有命令（配对/解绑/登录/导航/配置）。这些动作只应由本地页面发起 —— 远程页面（服务端下发的 Web UI）的权限见 main-remote.json，只额外获得「返回本地设置页」一个低危导航权限。",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "core:default",
    "allow-list-commands",
    "allow-device-status",
    "allow-runner-status",
    "allow-get-workspace-roots",
    "allow-set-workspace-roots",
    "allow-get-boot-state",
    "allow-pair-device",
    "allow-unpair-device",
    "allow-sign-out",
    "allow-sign-in",
    "allow-check-update",
    "allow-open-settings",
    "allow-open-logs",
    "allow-open-web-ui",
    "allow-open-baseline",
    "allow-set-server-base-url"
  ]
}
